{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent-workspace-kit/change-plan.schema.json",
  "title": "Wiki change plan",
  "description": "Produced by the wiki-librarian for /ingest, /wiki-query file-back and /wiki-dedup; validated by .claude/tools/validate-plan.sh before any write. Paths are relative to the repo root and anchored on the default VAULT_DIR 'vault' (validate-plan.sh rewrites the ^vault/ anchors when kit.conf renames it). Per-type required frontmatter for new pages is NOT listed here: validate-plan.sh reads it from the type registry in vault/schema.md, the single source of truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "source_hash", "target_project", "edits"],
  "definitions": {
    "sha1": {"type": "string", "pattern": "^sha1:[a-f0-9]{40}$"},
    "wikiPage": {"type": "string", "pattern": "^vault/wiki/[a-z0-9][a-z0-9/_-]*\\.md$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$", "maxLength": 60},
    "project": {"type": "string", "pattern": "^(cross|[a-z0-9][a-z0-9-]*)$"}
  },
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "op": {
      "type": "string",
      "enum": ["ingest", "file_back", "dedup"],
      "description": "Which command produced the plan. Defaults to ingest."
    },
    "created_at": {"type": "string", "description": "ISO 8601 timestamp with offset."},
    "source": {
      "type": "string",
      "description": "ingest: a raw file under vault/raw/<project>/<kind>/ (or a journal day file for memory distillation). file_back and dedup: the wiki page the plan derives from. Inbox items are moved to raw/ before ingest, never ingested in place.",
      "pattern": "^vault/(raw/[a-z0-9-]+/[a-z0-9-]+/|journal/|wiki/).+$"
    },
    "source_hash": {"$ref": "#/definitions/sha1", "description": "sha1 of the source file bytes, unmodified."},
    "target_project": {"$ref": "#/definitions/project"},
    "edits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op", "rationale", "confidence"],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "section_merge", "section_replace", "append", "add_alias", "add_source_ref",
              "extract_section", "replace_with_transclude", "set_canonical_for", "set_frontmatter"
            ]
          },
          "page": {"$ref": "#/definitions/wikiPage"},
          "page_hash_expected": {"$ref": "#/definitions/sha1", "description": "canonicalize.py --hash of the page when the plan was drafted."},
          "section": {"type": "string", "minLength": 1, "description": "H2 heading text without the leading '## '."},
          "content": {"type": "string"},
          "values": {"type": "array", "items": {"type": "string"}, "description": "add_alias / add_source_ref: entries merged into the frontmatter list."},
          "frontmatter": {
            "type": "object",
            "description": "set_frontmatter: only lifecycle keys may change.",
            "propertyNames": {"enum": ["status", "superseded_by", "last_verified", "temporal"]},
            "properties": {
              "status": {"enum": ["active", "superseded", "retracted"]},
              "temporal": {"enum": ["living", "snapshot"]},
              "last_verified": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
            }
          },
          "rationale": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "requires_link_update": {"type": "array", "items": {"$ref": "#/definitions/wikiPage"}},
          "source_page": {"$ref": "#/definitions/wikiPage"},
          "source_hash_expected": {"$ref": "#/definitions/sha1"},
          "source_section": {"type": "string", "minLength": 1},
          "target_page": {"$ref": "#/definitions/wikiPage"},
          "target_type": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "target_frontmatter": {"type": "object", "required": ["type", "project", "canonical_for"]},
          "transclude_target": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*#.+$", "description": "slug#Section"},
          "canonical_for": {"type": "array", "items": {"$ref": "#/definitions/slug"}}
        },
        "allOf": [
          {
            "if": {"properties": {"op": {"enum": ["section_merge", "section_replace", "append"]}}},
            "then": {"required": ["page", "page_hash_expected", "section", "content"]}
          },
          {
            "if": {"properties": {"op": {"enum": ["add_alias", "add_source_ref"]}}},
            "then": {"required": ["page", "values"]}
          },
          {
            "if": {"properties": {"op": {"const": "extract_section"}}},
            "then": {"required": ["source_page", "source_hash_expected", "source_section", "target_page", "target_type", "target_frontmatter"]}
          },
          {
            "if": {"properties": {"op": {"const": "replace_with_transclude"}}},
            "then": {"required": ["page", "page_hash_expected", "section", "transclude_target"]}
          },
          {
            "if": {"properties": {"op": {"const": "set_canonical_for"}}},
            "then": {"required": ["page", "page_hash_expected", "canonical_for"]}
          },
          {
            "if": {"properties": {"op": {"const": "set_frontmatter"}}},
            "then": {"required": ["page", "page_hash_expected", "frontmatter"]}
          }
        ]
      }
    },
    "new_pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "type", "frontmatter", "body"],
        "properties": {
          "page": {"$ref": "#/definitions/wikiPage"},
          "type": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "frontmatter": {
            "type": "object",
            "required": ["type", "project"],
            "properties": {
              "type": {"type": "string"},
              "project": {"$ref": "#/definitions/project"},
              "temporal": {"enum": ["living", "snapshot"]},
              "status": {"enum": ["active", "superseded", "retracted"]},
              "last_verified": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
              "aliases": {"type": "array", "items": {"type": "string"}},
              "sources": {"type": "array", "items": {"type": "string"}},
              "derived_from": {"type": "array", "items": {"type": "string"}},
              "canonical_for": {"type": "array", "items": {"$ref": "#/definitions/slug"}},
              "summary": {"type": "string", "maxLength": 1000}
            }
          },
          "body": {"type": "string", "minLength": 1, "maxLength": 80000}
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "reason"],
        "properties": {"page": {"type": "string"}, "reason": {"type": "string"}}
      }
    }
  }
}
