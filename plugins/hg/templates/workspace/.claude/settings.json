{
  "permissions": {
    "allow": [
      "Bash(hg-tool *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Edit(vault/raw/**)",
      "Edit(gates/**)"
    ]
  },
  "enabledPlugins": {
    "hg@human-gateway": true
  }
}
