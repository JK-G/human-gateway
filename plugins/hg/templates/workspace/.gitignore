# Personal notes and a person's own source files stay on this machine.
vault/daily/*
!vault/daily/README.md
intake/*
!intake/README.md
vault/raw/*
!vault/raw/README.md
vault/inbox/*
!vault/inbox/_template.md

# Generated per person
DASHBOARD.md
.gateway/

# Python leaves these when a tool in .github/hg/ is run by hand
__pycache__/
*.pyc

# Claude Code, per person
.claude/state/
.claude/settings.local.json

# A person's own instructions and skills
CLAUDE.local.md
.claude/skills/my-*/

# Obsidian settings differ per device
vault/.obsidian/

# Secrets
.env
.env.*
*.env
*.pem
*.p12
*.pfx
